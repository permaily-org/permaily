---
import Cta from '../components/Cta.astro';
import LlmCostDemo from '../components/demos/LlmCostDemo.astro';
import TokensDemo from '../components/demos/TokensDemo.astro';
import Faq from '../components/Faq.astro';
import PageHead from '../components/PageHead.astro';
import PlanCard from '../components/PlanCard.astro';
import { LINKS } from '../config/site';
import Base from '../layouts/Base.astro';

const queryDefinition = `query: >
  from:(iberia.com OR booking.com OR airbnb.com)
  subject:(booking OR reservation OR itinerary)
fields:
  is_cancellation: boolean
  cancellation_notes: string?
  refunded: boolean`;

const queryType = `type TravelBooking = {
  from: string;
  date: string;
  subject: string;
  isCancellation: boolean;
  cancellationNotes: string | null;
  refunded: boolean;
};`;

const comparison = [
  {
    topic: 'What you store',
    before: 'Whatever you fetched, often more than you need',
    after: 'Only what was released, if you store it at all',
  },
  {
    topic: 'What people see',
    before: 'A permission screen covering everything',
    after: 'The exact emails you’d receive, on their own mail',
  },
  {
    topic: 'Google review',
    before: 'Restricted-scope verification and a yearly security assessment',
    after: 'None of your own. Permaily holds the Google connection',
  },
  {
    topic: 'Providers',
    before: 'One integration per provider',
    after: 'One API for Gmail, Google Workspace and Microsoft 365',
  },
];

const interfaces = [
  {
    name: 'REST API',
    sample: 'GET /v1/messages?access=acc_9f2c',
    description: 'Search and read inside the slice, with the approved parts only.',
  },
  {
    name: 'Webhooks',
    sample: 'mail.matched',
    description:
      'Be told when mail you may read arrives, or on the person’s schedule, then fetch it.',
  },
  {
    name: 'Remote MCP',
    sample: 'https://mcp.permaily.com',
    description: 'Tools like describe_access, search_messages and get_message.',
  },
];

// TODO LEGAL: owner's review: webhooks (ADR 0039) as built, not released yet; the
// revision and the bounds are internal/webhook's (SpecRevision, TimestampTolerance,
// DedupKeepFor, NoticeLife).
const hookRequest = `POST https://api.permaily.com/oauth/par
client_id=https://trip-app.com/oauth/client.json
&webhook={"url":"https://trip-app.com/hooks/permaily/u1",
          "new_mail":true,
          "schedule":{"every":"week","on":"monday","at":"08:00"}}
&...the rest of your request

GET https://api.permaily.com/v1/connection
{"webhook":{"subscription":"sub_...","url":"https://trip-app.com/hooks/permaily/u1",
            "new_mail":true,"state":"on", ...}, ...}`;

const hookVerify = `import { WebhookAsymmetric } from 'standardwebhooks';

// The subscription GET /v1/connection gave you, and every key of
// https://api.permaily.com/.well-known/permaily-webhook-keys,
// each "whpk_" and the key in standard base64 (x is base64url).
const hook = new WebhookAsymmetric(subscription, publicKeys);

// The raw body and the webhook-id, webhook-timestamp and
// webhook-signature headers; throws unless a signature verifies.
const notice = hook.verify(body, headers);
if (notice.aud !== myURL) throw new Error('not for this URL');
if (await seenBefore(notice.id)) return reply(200); // kept 72 h 10 min
// Then fetch what arrived since notice.since, with this
// connection's token, and answer 2xx.`;

const hookRules = [
  'Your webhook is on exactly the host of your client_id, and only an app’s pushed request asks for one: MCP clients get none. The person accepts it with the rest of your request, and sees when you will be told.',
  'A notice is signed with Ed25519 as Standard Webhooks’ v2a says, at the specification’s revision 3d65b1824b6697f05a5a4584e7062bd23512fc8e, bound to your subscription. A library of that revision verifies it; one of an earlier revision knows only v1a and does not.',
  'The key set is published at https://api.permaily.com/.well-known/permaily-webhook-keys, a JWK set you may cache an hour, and on /status over the attested key, which permaily-verify compares. A new key is published 30 days before it signs alone; trust every key of the set.',
  'Refuse a timestamp more than five minutes from your clock, a notice whose aud is not the URL you received it on, and one made more than 72 hours and five minutes ago. Keep every notice id you took for 72 hours and ten minutes, and take each once: a retry carries the same id and body, signed again.',
  'A notice holds no mail: its type (mail.matched or schedule.due), its id, your subscription and client_id, the URL called, when it was made, the minute to fetch from, and for a schedule its time. Fetch with your token, which writes receipts as any read.',
  'Answer 2xx within ten seconds over HTTP/2, which is required. Anything else is tried again at one, five and fifteen minutes, then for up to 72 hours. A redirect is never followed. 410 Gone turns the webhook off for good.',
];

const questions = [
  {
    question: 'Can I still use my own LLM?',
    answer:
      'Yes, on the emails you receive. You just stop paying it to sort the rest. Every message is marked as untrusted content.',
  },
  {
    question: 'Do I still need Google’s verification?',
    answer:
      'No. Permaily holds the Google connection and goes through the review, so your app only talks to our API.',
  },
  {
    question: 'What if I need more mail later?',
    answer:
      'Ask again with the wider query. The person sees exactly what it would add, and nothing new reaches you until they approve.',
  },
  {
    question: 'Can I test without real mail?',
    answer: 'Yes. Test keys only see sandbox mailboxes with sample mail.',
  },
];
---

<Base title="Developers" description="Stop paying your LLM to read the whole inbox. Ask for the mail you need and get typed, structured data.">
  <PageHead intro="Ask for the mail you need, not a whole inbox. Permaily runs your query and returns typed, structured data, so your LLM doesn't have to read the emails.">
    Stop paying your LLM <br />to read the whole inbox
    <Fragment slot="actions">
      <a class="btn lg" href={LINKS.signup}>Get started</a>
      <a class="btn lg sec-b" href={LINKS.docs}>Read the docs</a>
    </Fragment>
  </PageHead>

  <section>
    <div class="wrap"><LlmCostDemo /></div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">Every query comes with its types</h2>
        <p class="intro">Your query says which emails you want and which fields come back. The SDK turns that into types, so you skip the prompt, the parsing and the validation.</p>
      </div>
      <div class="query-pair">
        <pre class="code-block" tabindex="0"><span class="c"># What your app asks for</span>{'\n\n'}{queryDefinition}</pre>
        <pre class="code-block" tabindex="0"><span class="c">// Generated by the SDK</span>{'\n\n'}{queryType}</pre>
      </div>
      <p class="more"><a class="link" href={LINKS.queries}>How queries work</a></p>
    </div>
  </section>

  <section class="sec rule-top" id="pricing">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">Pay for what you extract</h2>
        <p class="intro">Planned, not available yet. A token will be one processed unit of an email. Basic info will cost 1 token per email. Ask for more, and each email will cost more.</p>
      </div>
      <TokensDemo />
      <PlanCard
        name="Developer"
        price="$0.01"
        unit="per 1M tokens"
        note="Planned, not available yet. Pay as you go"
        description="For products that read email with consent."
        items={[
          'Typed, structured output from your query',
          'REST API, webhooks and SDKs',
          'Hosted consent screen',
          'Sandbox mailboxes',
          'Email support',
        ]}
        action={{ label: 'Get started', href: LINKS.signup }}
        primary
        split
      />
    </div>
  </section>

  <section class="sec rule-top">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">What else changes when you ask for less</h2>
      </div>
      <div class="tbl-scroll">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col"><span class="sr">Topic</span></th>
              <th scope="col">Gmail and your LLM</th>
              <th scope="col">Permaily</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row">{row.topic}</th>
                  <td>{row.before}</td>
                  <td>{row.after}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <h3 class="h-h same-view">One view of the inbox, however you read it</h3>
      <div class="three">
        {
          interfaces.map((item) => (
            <div class="iface">
              <h3>{item.name}</h3>
              <code>{item.sample}</code>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec rule-top" id="webhooks">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">Told when there is mail</h2>
        <p class="intro">Not released yet. Your app can ask to be told when mail it may read arrives, or every day or week at a time the person chose. Permaily sends a signed notice from the verified environment that there is mail to fetch, never the mail.</p>
      </div>
      <div class="query-pair">
        <pre class="code-block" tabindex="0"><span class="c"># Ask in your pushed request, then read your subscription</span>{'\n\n'}{hookRequest}</pre>
        <pre class="code-block" tabindex="0"><span class="c">// Verify a notice with Standard Webhooks' library</span>{'\n\n'}{hookVerify}</pre>
      </div>
      <ul class="hook-rules">
        {hookRules.map((rule) => <li>{rule}</li>)}
      </ul>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="wrap two">
      <h2 class="h-l">Questions before you switch</h2>
      <Faq items={questions} />
    </div>
  </section>

  <Cta
    title="Ask for less"
    body="Create an app, run your first query in the sandbox, and see what comes back."
    primary={{ label: 'Get started', href: LINKS.signup }}
    secondary={{ label: 'Read the docs', href: LINKS.docs }}
  />
</Base>

<style>
  .query-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-12);
  }

  .more {
    margin-top: var(--space-20);
  }

  .hook-rules {
    display: grid;
    gap: var(--space-12);
    margin-top: var(--space-24);
    padding-left: var(--space-20);
    color: var(--ink-2);
    font-size: var(--text-lead);
  }

  .same-view {
    margin-block: var(--space-64) var(--space-24);
  }

  .iface {
    display: grid;
    align-content: start;
    gap: var(--space-8);
    padding-top: var(--space-14);
    border-top: var(--hair) solid var(--rule-strong);
  }

  .iface h3 {
    font-size: var(--text-title);
    font-weight: 500;
  }

  .iface code {
    justify-self: start;
    overflow: hidden;
    max-width: 100%;
    padding: 4px 8px;
    border-radius: var(--r);
    background: var(--sunken);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .iface p {
    color: var(--ink-2);
    font-size: var(--text-lead);
  }

  @media (max-width: 980px) {
    .query-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
