---
import Cta from '../components/Cta.astro';
import ChatDemo from '../components/demos/ChatDemo.astro';
import EmblemDemo from '../components/demos/EmblemDemo.astro';
import LineDemo from '../components/demos/LineDemo.astro';
import SeaDemo from '../components/demos/SeaDemo.astro';
import { LINKS } from '../config/site';
import Base from '../layouts/Base.astro';
---

<Base description="Share only the part of your email each app or AI agent needs, and check that we kept our word.">
  <section class="hero">
    <div class="wrap">
      <div class="hero-say">
        <h1>Stop giving away your inbox.</h1>
        <p>Take back control and protect what matters to you.</p>
      </div>
      <div class="actions hero-act">
        <a class="btn lg" href={LINKS.signup}>Join the waitlist</a>
      </div>
    </div>
    <SeaDemo />
  </section>

  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">Keep using your favorite email <br /><span class="dim">We just sit between it and your other apps</span></h2>
      </div>
      <LineDemo />
    </div>
  </section>

  <section class="sec rule-top" id="agents">
    <div class="wrap two">
      <div class="stack">
        <h2 class="h-l">Ready for your AI agents</h2>
        <p class="intro">Add one address to Claude, ChatGPT, Muse, Grok Bot or any other AI agent. Connecting shares no mail, and it can’t send or delete anything without asking you.</p>
        <a class="link fine more" href={LINKS.remoteMcp}>See how to connect your tools with our MCP server and plugins</a>
      </div>
      <ChatDemo />
    </div>
  </section>

  <section class="sec rule-top" id="security">
    <div class="wrap">
      <EmblemDemo>
        <h2 class="h-l">Security is our top priority</h2>
        <p class="intro"><strong>Don’t take our word for it.</strong></p>
        <a slot="more" class="link fine more" href="/security/">What this proves, and what it doesn’t</a>
      </EmblemDemo>
    </div>
  </section>

  <Cta
    title="Your inbox, your rules"
    body="Decide what every app and AI agent can read, and keep the rest private. Free for personal use, no card required."
    primary={{ label: 'Get started', href: LINKS.signup }}
    secondary={{ label: 'See pricing', href: '/pricing/' }}
  />
</Base>

<style>
  .hero {
    padding-block: clamp(36px, 3.4vw, 48px) 0;
  }

  /* The hero's words are sized from the width of this block, so it is named as the thing to measure. */
  .hero > .wrap {
    container-type: inline-size;
  }

  /* Two lines across the page, in two tones: the headline in ink, and under it, dimmer, what to do about
     it. On a phone the type holds its size and the sentences wrap. */
  .hero-say {
    font-size: min(7.6vw, 32px);
    font-weight: 500;
    letter-spacing: var(--tracking-l);
    line-height: var(--leading-display);
    text-wrap: balance;
  }

  /* On anything wider, each sentence keeps to one line. The longer one is 22.3 times the type's size, so the
     type is set a little under that share of the block: 4.32 hundredths of its width. It is measured from the
     block and not from the window, because a window's width counts its scrollbar and the block's does not,
     and a scrollbar is wider than the room the line has to spare. */
  @media (min-width: 761px) {
    /* For a browser without container units: about the same size, from the window. */
    .hero-say {
      font-size: clamp(28px, 3.7vw, 54px);
    }

    @supports (width: 1cqw) {
      .hero-say {
        font-size: max(28px, 4.32cqw);
      }
    }
  }

  .hero-say h1,
  .hero-say p {
    font: inherit;
    letter-spacing: inherit;
  }

  /* The headline is a size above the sentence under it. It is the shorter of the two, so it still keeps
     to its line. */
  .hero-say h1 {
    font-size: 1.3em;
  }

  .hero-say p {
    color: var(--ink-3);
  }

  .hero-act {
    margin-top: clamp(24px, 2.6vw, 36px);
  }

  /* The link that closes a section's words: as wide as its text, so only the words can be clicked. */
  .more {
    justify-self: start;
  }

  /* The opening words of a section's lead, in ink where the rest is dimmer. */
  .intro strong {
    color: var(--ink);
    font-weight: 500;
  }
</style>
