---
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import PageHead from '../components/PageHead.astro';
import PlanCard from '../components/PlanCard.astro';
import { LINKS } from '../config/site';
import Base from '../layouts/Base.astro';

const questions = [
  {
    question: 'Is Personal really free?',
    answer:
      'Yes. Paid plans for developers and companies are planned to pay for it, and we don’t sell, mine or advertise on email.',
  },
  {
    question: 'Can companies sign up?',
    answer:
      'Not yet. The Companies plan is planned, at the prices shown; for now Permaily is only for people using it for their own mail.',
  },
  {
    question: 'What happens to my data if I leave?',
    answer:
      'Revoking and deleting are free, and deleting your account removes your data as Deleting your data describes. An export is planned; until then, ask us for a copy.',
  },
  {
    question: 'Which payment methods do you accept?',
    answer:
      'None yet: there’s nothing to pay for. Cards, and invoices on yearly Companies plans, are planned.',
  },
];
---

<Base title="Pricing" description="Free for people, by invitation. Paid plans for developers and companies are planned, not available yet.">
  <PageHead intro="Personal is free, by invitation. Developers paying for what they extract, and companies paying per seat, are planned, and are how we mean to stay in business without selling, mining or advertising on email.">
    Free for people <br class="keep" /><span class="dim">Never paid for with your mail</span>
  </PageHead>

  <section>
    <div class="wrap">
      <div class="plans">
        <PlanCard
          name="Personal"
          price="$0"
          unit="forever"
          note="No card needed"
          description="For people in the United States connecting their own tools. By invitation; what’s below is being built and opens as it’s ready."
          items={[
            'Your own mailboxes',
            'Any app or AI agent you approve',
            'Rules that hold back emails or remove details',
            'Rules in your own words, such as “my car”',
            'A receipt for every email shared',
          ]}
          action={{ label: 'Sign up by invitation', href: LINKS.signup }}
          primary
        />
        <PlanCard
          name="Companies"
          price="$12"
          unit="per seat, per month"
          note="Planned, not available yet. Billed yearly, or $15 monthly"
          description="One central plan for your company’s inboxes."
          items={[
            'Google Workspace and Microsoft 365',
            'Per-vendor limits and central policy',
            'SSO and SCIM',
            'Audit export',
            'Priority support',
          ]}
          action={{ label: 'Tell us you’re interested', href: '/contact/' }}
        />
      </div>
      <p class="plan-dev">Building a product that reads email? Developer pricing per token is planned. <a class="link" href="/developers/#pricing">See developer pricing</a></p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap routes">
      <div class="route">
        <h3>Leaving is never a paid feature</h3>
        <p>Revoking access, deleting your account and checking the proof are free, and exporting your data will be too.</p>
      </div>
      <div class="route">
        <h3>Or run it yourself</h3>
        <p>The same public code, in your own AWS account. You hold the keys. Organisations need a commercial license to self-host.</p>
        <a class="go link guide" href={LINKS.selfHosting}>Read the self-hosting guide</a>
      </div>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="wrap two">
      <h2 class="h-l">Questions about pricing</h2>
      <Faq items={questions} />
    </div>
  </section>

  <Cta
    title="Personal is free"
    body="Free, by invitation. Today you can make an account; mailboxes and connections come next, and nothing is shared until you approve it."
    primary={{ label: 'Sign up by invitation', href: LINKS.signup }}
    secondary={{ label: 'Talk to us', href: '/contact/' }}
  />
</Base>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .plan-dev {
    margin-top: var(--space-32);
    padding-top: var(--space-14);
    border-top: var(--hair) solid var(--rule);
    color: var(--ink-2);
    font-size: var(--text-title);
  }

  .guide {
    justify-self: start;
  }

  @media (max-width: 860px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
