---
import PageHead from '../components/PageHead.astro';
import { LINKS } from '../config/site';
import Base from '../layouts/Base.astro';
---

<Base title="Changelog" description="Published releases are listed in our GitHub release log, each with its source commit, build provenance and attested measurements.">
  <PageHead intro="Published releases are listed in our GitHub release log. Open a release for its source commit, build provenance and attested measurements.">
    Release history
    <Fragment slot="actions">
      <a class="btn lg sec-b" href={LINKS.releaseLog}>Open the release log</a>
    </Fragment>
  </PageHead>
  <div class="page-end"></div>
</Base>
