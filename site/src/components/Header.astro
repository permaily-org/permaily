---
import { LINKS, NAV } from '../config/site';

interface Props {
  minimal?: boolean;
  /** Docs pages already sit inside a <header>, so they render this as a <div>. */
  as?: 'header' | 'div';
}

const { minimal = false, as: Tag = 'header' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<Tag class="site-head">
  {
    minimal ? (
      <div class="wrap inner only-word">
        <a class="word" href="/">Permaily</a>
      </div>
    ) : (
      <>
        <div class="wrap inner">
          <a class="word" href="/">Permaily</a>
          <nav class="site-nav" aria-label="Main">
            {NAV.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <div class="site-act">
            <a class="only-wide" href={LINKS.docs} aria-current={path.startsWith(LINKS.docs) ? 'true' : undefined}>Docs</a>
            <a class="btn" href={LINKS.signup}>Get started free</a>
            <button class="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Menu">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                <path class="b" d="M2 5h14M2 9h14M2 13h14" />
                <path class="x" d="M4 4l10 10M14 4L4 14" />
              </svg>
            </button>
          </div>
        </div>
        <div class="menu" id="menu">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={LINKS.docs}>Docs</a>
          <a href={LINKS.login}>Log in</a>
        </div>
      </>
    )
  }
</Tag>

<style is:global>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: var(--hair) solid var(--rule);
    background: var(--paper);
  }

  .site-head .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-24);
    height: 64px;
  }

  .site-head .inner.only-word {
    grid-template-columns: 1fr;
  }

  .word {
    font-size: var(--text-wordmark);
    font-weight: 600;
    letter-spacing: var(--tracking-w);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: var(--space-24);
  }

  .site-nav a,
  .site-act a:not(.btn) {
    color: var(--ink-2);
    font-size: var(--text-body);
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-act a:not(.btn):hover {
    color: var(--ink);
  }

  .site-nav a[aria-current='page'],
  .site-act a[aria-current='true'] {
    color: var(--ink);
    font-weight: 500;
  }

  .site-act {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-20);
  }

  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .menu-btn svg {
    display: block;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .menu-btn .x {
    display: none;
  }

  .menu-btn[aria-expanded='true'] .x {
    display: block;
  }

  .menu-btn[aria-expanded='true'] .b {
    display: none;
  }

  .menu {
    display: none;
  }

  @media (max-width: 860px) {
    .site-head .inner {
      grid-template-columns: 1fr auto;
      height: 56px;
    }

    .site-nav,
    .site-act .only-wide {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }

    .site-act {
      gap: var(--space-16);
    }

    .menu[data-open='true'] {
      position: fixed;
      inset: 56px 0 0;
      z-index: 39;
      display: grid;
      align-content: start;
      gap: var(--space-4);
      overflow: auto;
      padding: var(--space-24) var(--gutter);
      background: var(--paper);
    }

    .menu a {
      padding-block: 10px;
      border-bottom: var(--hair) solid var(--rule);
      font-size: var(--text-heading);
      font-weight: 500;
      letter-spacing: var(--tracking-h);
      text-decoration: none;
    }
  }
</style>
