---
// A "Sign up with Google" button: Google's own light button, as the web app draws it (docs/web.md, "Each
// provider's mark"). It is a link to the app's sign-up screen, where signing up with Google happens.
//
// Nothing here is a colour. The button's colours, the colours inside the "G" and Google's font are written in
// the web app's brands.css, the one place for providers' colours (docs/design.md, "Providers' marks"), which
// this file brings in. The "G" is Google's artwork, copied as the web app's marks.tsx has it: do not
// redraw or recolour it.
import '../../../../web/src/components/brands/brands.css';

interface Props {
  href: string;
  /** Names the parts of this button's "G". Give each button on a page its own. */
  id?: string;
}

const { href, id = 'google-g' } = Astro.props;
const circle =
  'M7.25922 19.7927C7.25922 12.6759 13.0209 6.90668 20.1283 6.90668C27.2357 6.90668 32.9973 12.6759 32.9973 19.7927C32.9973 26.9094 27.2357 32.6786 20.1283 32.6786C13.0209 32.6786 7.25921 26.9094 7.25922 19.7927Z';
const blurs = [
  { x: 5.25922, y: 4.90668, width: 29.7381, height: 29.772 },
  { x: 12.9977, y: 14.828, width: 14.1038, height: 10.8265 },
  { x: 23.9146, y: 13.1219, width: 18.8784, height: 10.1871 },
  { x: 15.8659, y: 11.8415, width: 18.8171, height: 8.7561 },
  { x: 20.1341, y: 8.54878, width: 18.8171, height: 8.7561 },
  { x: 13.9756, y: 14.7683, width: 21.0122, height: 10.2195 },
  { x: 19.0404, y: 9.00419, width: 12.2878, height: 10.0309 },
];
---

<a class="google-sign-up provider-google" href={href}>
  <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="10 10 20 20" fill="none">
    <mask id={`${id}-mask`} class="provider-google-mask" maskUnits="userSpaceOnUse" x="10" y="10" width="20" height="20">
      <path
        class="provider-google-shape"
        d="M29.3987 18.1814H19.9849V22.0445H25.3598C25.1286 23.294 24.4294 24.3596 23.3676 25.0712C22.4746 25.6716 21.3266 26.0211 19.9849 26.0211C17.3864 26.0211 15.1823 24.2666 14.3947 21.9004C14.1952 21.2989 14.0853 20.6599 14.0853 19.9983C14.0853 19.3367 14.1952 18.6966 14.3947 18.0962C15.1823 15.7311 17.3864 13.9755 19.9849 13.9755C21.4524 13.9755 22.767 14.4816 23.8039 15.4713L26.6653 12.6057C24.936 10.9908 22.6786 10 19.9849 10C16.0832 10 12.705 12.2414 11.0618 15.5076C10.383 16.8592 10 18.3834 10 19.9994C10 21.6155 10.383 23.1396 11.0618 24.4913C12.705 27.7597 16.0832 30 19.9849 30C22.6797 30 24.9485 29.1137 26.6018 27.5861C28.4887 25.8452 29.5732 23.2702 29.5732 20.2275C29.5732 19.5182 29.5131 18.835 29.3987 18.1825V18.1814Z"
      ></path>
    </mask>
    <g mask={`url(#${id}-mask)`}>
      <g filter={`url(#${id}-blur0)`}>
        <g clip-path={`url(#${id}-sweep)`}>
          <g transform="matrix(0.00804129 -0.00805186 0.00804128 0.00805186 19.6819 19.7927)">
            <foreignObject x="-2105.64" y="-2105.64" width="4211.29" height="4211.29">
              <div class="provider-google-sweep"></div>
            </foreignObject>
          </g>
        </g>
        <path d={circle}></path>
      </g>
      <g filter={`url(#${id}-blur1)`}>
        <ellipse
          class="provider-google-blue"
          cx="20.0496"
          cy="20.2413"
          rx="5.39634"
          ry="2.83537"
          transform="rotate(24.4473 20.0496 20.2413)"></ellipse>
      </g>
      <g filter={`url(#${id}-blur2)`}>
        <ellipse class="provider-google-blue" cx="33.3538" cy="18.2155" rx="7.43918" ry="3.09357"></ellipse>
      </g>
      <g filter={`url(#${id}-blur3)`}>
        <ellipse class="provider-google-red" cx="25.2744" cy="16.2195" rx="7.40854" ry="2.37805"></ellipse>
      </g>
      <g filter={`url(#${id}-blur4)`}>
        <ellipse class="provider-google-pink" cx="29.5427" cy="12.9268" rx="7.40854" ry="2.37805"></ellipse>
      </g>
      <g filter={`url(#${id}-blur5)`}>
        <ellipse class="provider-google-blue" cx="24.4817" cy="19.878" rx="8.5061" ry="3.10976"></ellipse>
      </g>
      <g filter={`url(#${id}-blur6)`}>
        <ellipse
          class="provider-google-red"
          cx="25.1842"
          cy="14.0197"
          rx="4.53882"
          ry="2.37805"
          transform="rotate(-28.6599 25.1842 14.0197)"></ellipse>
      </g>
    </g>
    <defs>
      {
        blurs.map((blur, i) => (
          <filter
            id={`${id}-blur${i}`}
            x={blur.x}
            y={blur.y}
            width={blur.width}
            height={blur.height}
            filterUnits="userSpaceOnUse"
            color-interpolation-filters="sRGB"
          >
            <feFlood flood-opacity="0" result="BackgroundImageFix" />
            <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape" />
            <feGaussianBlur stdDeviation="1" result="effect1_foregroundBlur" />
          </filter>
        ))
      }
      <clipPath id={`${id}-sweep`}>
        <path d={circle}></path>
      </clipPath>
    </defs>
  </svg>
  Sign up with Google
</a>

<style is:global>
  /* The shape Google fixes: 40px tall, 12px on each side, 10px between the "G" and the words, set 14 on 20. */
  .google-sign-up {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding-inline: 12px;
    border-width: var(--hair);
    border-style: solid;
    border-radius: var(--r);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    text-decoration: none;
    white-space: nowrap;
  }

  .google-sign-up svg {
    flex: none;
  }
</style>
