{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "permaily-host",
            "log_stream_name": "{instance_id}",
            "units": ["permaily-host", "permaily-enclave"]
          }
        ]
      }
    }
  }
}
