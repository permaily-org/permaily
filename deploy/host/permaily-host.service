[Unit]
Description=Permaily host proxy (untrusted: TCP to vsock forwarding and allowlisted egress)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/permaily/permaily-host

[Service]
ExecStart=/opt/permaily/permaily-host -enclave-cid 16 -forward :443=443 -egress-port 8000
Restart=always
RestartSec=2
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
