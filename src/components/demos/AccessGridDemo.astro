---
const columns = [
  { key: 'flights', label: 'Flights and hotels', count: '47' },
  { key: 'invoices', label: 'Invoices', count: '212' },
  { key: 'receipts', label: 'Receipts', count: '388' },
  { key: 'news', label: 'Newsletters', count: '1,204' },
  { key: 'rest', label: 'Everything else', count: '10,129' },
];

const connections = [
  { id: 'trip', tile: 'TA', name: 'Trip App', shared: ['flights'] },
  { id: 'claude', tile: 'CL', name: 'Claude', shared: ['flights', 'invoices'] },
  { id: 'ledgerly', tile: 'LE', name: 'Ledgerly', shared: ['invoices', 'receipts'] },
];
---

<div class="demo" data-demo="grid">
  <p class="grid-title">
    <span data-conns>3</span> <span data-pl>connections</span> can read <span class="mk" data-count>647</span> of your 12,304 emails
  </p>
  <div class="ag">
    <div class="ch"></div>
    {columns.map((c) => <div class="ch"><span>{c.label}</span><span class="mono">{c.count}</span></div>)}
    <div class="ch"><span>Withheld from all</span><span class="mono">324</span></div>
    <div class="ch centered"><span>On</span></div>
    {
      connections.map((connection) => (
        <div class="ag-row">
          <div class="rh">
            <span class="tile">{connection.tile}</span>
            {connection.name}
          </div>
          {columns.map((c) => {
            const on = connection.shared.includes(c.key) ? 'true' : 'false';
            return (
              <button
                class="cell"
                data-c={connection.id}
                data-k={c.key}
                data-on={on}
                aria-pressed={on}
                aria-label={`${connection.name}, ${c.label}`}
              >
                <span class="blk" />
                <span class="lab">{c.label}</span>
                <span class="val">{c.count}</span>
              </button>
            );
          })}
          <button class="cell never" aria-disabled="true" aria-label={`${connection.name}, Withheld from all. These rules win over every rule a connection uses.`}>
            <span class="blk" />
            <span class="lab">Withheld from all</span>
            <span class="nv">never</span>
          </button>
          <div class="sw-cell">
            <button class="sw" role="switch" aria-checked="true" data-c={connection.id} aria-label={`${connection.name} access`} />
          </div>
        </div>
      ))
    }
  </div>
  <div class="ag-foot">
    <span data-hint>Try it. Change any square, or turn a connection off.</span>
    <button class="demo-ctl" data-reset hidden>Reset</button>
  </div>
</div>

<style is:global>
  .grid-title {
    margin-bottom: var(--space-20);
    font-size: var(--text-heading);
    font-weight: 500;
    letter-spacing: var(--tracking-h);
    line-height: var(--leading-display);
  }

  .ag {
    display: grid;
    grid-template-columns: minmax(150px, 1.3fr) repeat(6, minmax(0, 1fr)) 72px;
    align-items: stretch;
    gap: 3px;
  }

  .ag-row {
    display: contents;
  }

  .ag .ch {
    display: grid;
    align-content: end;
    gap: 2px;
    padding: 0 4px var(--space-10) 0;
    color: var(--ink);
    font-size: var(--text-small);
    line-height: 1.25;
  }

  .ag .ch.centered {
    justify-items: center;
  }

  .ag .ch .mono {
    color: var(--ink-2);
  }

  .ag .rh {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    min-height: 64px;
    padding-right: var(--space-8);
    font-size: var(--text-lead);
    font-weight: 500;
  }

  .cell {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    min-height: 64px;
    padding: 0 var(--space-12);
    background: var(--highlight);
    color: var(--on-highlight);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    text-align: left;
  }

  .cell > .blk {
    position: absolute;
    inset: 0;
    background: var(--bar);
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.34s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cell[data-on='true'] > .blk {
    transform: scaleX(0);
    transform-origin: right;
  }

  .cell > .lab {
    position: relative;
    display: none;
  }

  .cell.never {
    cursor: not-allowed;
  }

  .cell.never > .nv {
    position: absolute;
    left: var(--space-12);
    top: 50%;
    color: var(--on-bar);
    font-size: var(--text-mono);
    font-weight: 400;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  .cell .val {
    position: relative;
    opacity: 0;
  }

  .cell[data-on='true'] .val {
    opacity: 1;
    transition: opacity 0.2s 0.1s;
  }

  .sw.ring {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .sw-cell {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sw {
    position: relative;
    width: 38px;
    height: 22px;
    border: var(--hair) solid var(--ink);
    border-radius: var(--r);
    background: transparent;
    transition: background 0.2s;
  }

  .sw::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    background: var(--ink);
    transition: transform 0.2s, background 0.2s;
  }

  .sw[aria-checked='true'] {
    background: var(--ink);
  }

  .sw[aria-checked='true']::after {
    background: var(--paper);
    transform: translateX(16px);
  }

  .ag-foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
    min-height: 20px;
    margin-top: var(--space-12);
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  @media (max-width: 980px) {
    .ag {
      display: block;
    }

    .ag .ch {
      display: none;
    }

    .ag-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3px;
      margin-bottom: var(--space-24);
    }

    .ag .rh {
      grid-column: 1 / 3;
      grid-row: 1;
      min-height: 44px;
    }

    .sw-cell {
      grid-column: 3;
      grid-row: 1;
      justify-content: flex-end;
    }

    .cell {
      padding: var(--space-8);
    }

    .cell > .lab {
      display: block;
      color: var(--on-highlight);
      font-family: var(--font-sans);
      font-size: var(--text-micro);
      font-weight: 400;
      line-height: 1.2;
    }

    .cell[data-on='false'] > .lab,
    .cell.never > .lab {
      color: var(--on-bar);
    }

    .cell.never > .nv {
      display: none;
    }

    .cell .val {
      display: block;
    }

    .cell[data-on='false'] .val {
      display: none;
    }
  }
</style>

<script>
  import { initGrid } from '../../scripts/demos/grid';

  document.querySelectorAll<HTMLElement>('[data-demo="grid"]').forEach(initGrid);
</script>
