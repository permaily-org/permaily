---
import Cta from '../components/Cta.astro';
import LlmCostDemo from '../components/demos/LlmCostDemo.astro';
import TokensDemo from '../components/demos/TokensDemo.astro';
import Faq from '../components/Faq.astro';
import PageHead from '../components/PageHead.astro';
import PlanCard from '../components/PlanCard.astro';
import { LINKS } from '../config/site';
import Base from '../layouts/Base.astro';

const packDefinition = `id: travel.bookings
version: 3
match:
  any:
    - schema_org: [FlightReservation, LodgingReservation]
    - from_domain: [iberia.com, booking.com, airbnb.com]
fields:
  is_cancellation: boolean
  cancellation_notes: string?
  refunded: boolean`;

const packType = `type TravelBooking = {
  from: string;
  date: string;
  subject: string;
  isCancellation: boolean;
  cancellationNotes: string | null;
  refunded: boolean;
};`;

const comparison = [
  {
    topic: 'What you store',
    before: 'Whatever you fetched, often more than you need',
    after: 'Only what was released, if you store it at all',
  },
  {
    topic: 'What people see',
    before: 'A permission screen covering everything',
    after: 'The exact emails you’d receive, on their own mail',
  },
  {
    topic: 'Google review',
    before: 'Restricted-scope verification and a yearly security assessment',
    after: 'None of your own. Permaily holds the Google connection',
  },
  {
    topic: 'Providers',
    before: 'One integration per provider',
    after: 'One API for Gmail, Google Workspace and Microsoft 365',
  },
];

const interfaces = [
  {
    name: 'REST API',
    sample: 'GET /v1/messages?access=acc_9f2c',
    description: 'Search and read inside the slice, with the approved parts only.',
  },
  {
    name: 'Webhooks',
    sample: 'message.released',
    description: 'Get new matching mail as it arrives, signed, with its receipt id.',
  },
  {
    name: 'Remote MCP',
    sample: 'https://mcp.permaily.com',
    description: 'Tools like describe_access, search_messages and get_message.',
  },
];

const questions = [
  {
    question: 'Can I still use my own LLM?',
    answer: 'Yes, on the emails you receive. You just stop paying it to sort the rest. Every message is marked as untrusted content.',
  },
  {
    question: 'Do I still need Google’s verification?',
    answer: 'No. Permaily holds the Google connection and goes through the review, so your app only talks to our API.',
  },
  {
    question: 'What if a pack doesn’t cover what I need?',
    answer: 'Write a rule in your app’s request, or propose a change to the pack. Everything still goes through the same consent screen and preview.',
  },
  {
    question: 'Can I test without real mail?',
    answer: 'Yes. Test keys only see sandbox mailboxes with sample mail.',
  },
];
---

<Base title="Developers" description="Stop paying your LLM to read the whole inbox. Ask for one pack and get typed, structured data.">
  <PageHead intro="Ask for one pack, not a whole inbox. Permaily finds the right emails and returns typed, structured data, so your LLM doesn't have to read them.">
    Stop paying your LLM <br />to read the whole inbox
    <Fragment slot="actions">
      <a class="btn lg" href={LINKS.signup}>Create an app</a>
      <a class="btn lg sec-b" href={LINKS.docs}>Read the docs</a>
    </Fragment>
  </PageHead>

  <section>
    <div class="wrap"><LlmCostDemo /></div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">Every pack comes with its types</h2>
        <p class="intro">A pack defines which emails match and which fields come back. The SDK turns that into types, so you skip the prompt, the parsing and the validation.</p>
      </div>
      <div class="pack-pair">
        <pre class="code-block"><span class="c">packs/travel.bookings.yaml</span>{'\n\n'}{packDefinition}</pre>
        <pre class="code-block"><span class="c">// Generated by the SDK</span>{'\n\n'}{packType}</pre>
      </div>
      <p class="catalogue"><a class="link" href={LINKS.packs}>Browse the pack catalogue</a></p>
    </div>
  </section>

  <section class="sec rule-top" id="pricing">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">Pay for what you extract</h2>
        <p class="intro">A token is one processed unit of an email. Basic info costs 1 token per email. Ask for more, and each email costs more.</p>
      </div>
      <TokensDemo />
      <PlanCard
        name="Developer"
        price="$0.01"
        unit="per 1M tokens"
        note="Pay as you go"
        description="For products that read email with consent."
        items={[
          'Typed, structured output from each pack',
          'REST API, webhooks and SDKs',
          'Hosted consent screen',
          'Sandbox mailboxes',
          'Email support',
        ]}
        action={{ label: 'Create an app', href: LINKS.signup }}
        primary
        split
      />
    </div>
  </section>

  <section class="sec rule-top">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-l">What else changes when you ask for less</h2>
      </div>
      <div class="tbl-scroll">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col"><span class="sr">Topic</span></th>
              <th scope="col">Gmail and your LLM</th>
              <th scope="col">Permaily</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row">{row.topic}</th>
                  <td>{row.before}</td>
                  <td>{row.after}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <h3 class="h-h same-view">One view of the inbox, however you read it</h3>
      <div class="three">
        {
          interfaces.map((item) => (
            <div class="iface">
              <h3>{item.name}</h3>
              <code>{item.sample}</code>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="wrap two">
      <h2 class="h-l">Questions before you switch</h2>
      <Faq items={questions} />
    </div>
  </section>

  <Cta
    title="Ask for less"
    body="Create an app, request your first pack in the sandbox, and see what comes back."
    primary={{ label: 'Create an app', href: LINKS.signup }}
    secondary={{ label: 'Read the docs', href: LINKS.docs }}
  />
</Base>

<style>
  .pack-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-12);
  }

  .catalogue {
    margin-top: var(--space-20);
  }

  .same-view {
    margin-block: var(--space-64) var(--space-24);
  }

  .iface {
    display: grid;
    align-content: start;
    gap: var(--space-8);
    padding-top: var(--space-14);
    border-top: var(--hair) solid var(--rule-strong);
  }

  .iface h3 {
    font-size: var(--text-title);
    font-weight: 500;
  }

  .iface code {
    justify-self: start;
    overflow: hidden;
    max-width: 100%;
    padding: 4px 8px;
    border-radius: var(--r);
    background: var(--sunken);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .iface p {
    color: var(--ink-2);
    font-size: var(--text-lead);
  }

  @media (max-width: 980px) {
    .pack-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
