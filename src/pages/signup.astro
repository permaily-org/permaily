---
import AuthForm from '../components/AuthForm.astro';
import Redact from '../components/Redact.astro';
import { LINKS } from '../config/site';
import { MAIL } from '../data/mail';
import Base from '../layouts/Base.astro';
---

<Base title="Create your account" description="Connecting shares nothing." minimal>
  <div class="auth">
    <AuthForm
      title="Create your account"
      subtitle="Connecting a mailbox comes next, and connecting shares nothing."
      switchQuestion="Already have an account?"
      switchLabel="Log in"
      switchHref={LINKS.login}
    />
    <div class="pane side">
      <div class="stack nothing">
        <p class="small">What Permaily can read right now</p>
        <p class="h-l"><span class="mk">0</span> of your emails</p>
        <div aria-hidden="true">
          {MAIL.slice(0, 6).map((mail) => <div class="ml"><Redact text={mail.subject} withheld /></div>)}
        </div>
        <p class="fine">Nothing is connected yet, and that’s how every connection starts.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .nothing {
    width: 100%;
    max-width: 440px;
  }

  .ml {
    --bar-h: 13px;
    display: flex;
    align-items: center;
    overflow: hidden;
    height: 40px;
    border-bottom: var(--hair) solid var(--rule);
  }
</style>
